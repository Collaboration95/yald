{
  "name": "yald-dashboard",
  "version": "0.3.0",
  "description": "Local, read-only analytics for opencodex and Claude Code usage, with Yaldi as Yald's detective companion",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/Collaboration95/yald.git" },
  "homepage": "https://github.com/Collaboration95/yald#readme",
  "bugs": { "url": "https://github.com/Collaboration95/yald/issues" },
  "bin": { "yald": "scripts/yald.mjs" },
  "files": ["server/src", "web/dist", "scripts/yald.mjs", "scripts/demo.mjs", "scripts/demo", "LICENSE", "README.md", "CHANGELOG.md", "docs/install.md", "docs/metrics.md", "docs/api.md", "docs/architecture.md", "docs/demo.md", "docs/guide.md", "docs/labs-evidence.md", "docs/labs-context.md", "docs/releasing.md", "docs/release-evidence.md", "docs/release-notes-v0.2.0.md", "docs/release-candidate-v0.2.0.md", "docs/screenshots/overview.png", "docs/screenshots/meet-yaldi-0.2.0", "CONTRIBUTORS.md"],
  "dependencies": { "bun": "^1.4.0", "hono": "^4.13.9" },
  "devDependencies": { "oxlint": "^1.86.0" },
  "type": "module",
  "workspaces": ["server", "web"],
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "serve": "bash scripts/serve.sh",
    "build": "bash -c 'scripts/bun run --cwd web vite build'",
    "start": "bash -c 'scripts/bun run server/src/index.ts'",
    "smoke": "bash scripts/smoke.sh",
    "typecheck": "bash -c 'scripts/bun run --cwd web typecheck && scripts/bun run --cwd server typecheck'",
    "test": "scripts/bun test",
    "test:fast": "scripts/bun test --bail server/src tests/relay-style.test.ts tests/demo.test.ts",
    "lint": "scripts/bun x oxlint server/src web/src",
    "check:fast": "scripts/bun run lint && scripts/bun run test:fast",
    "hooks:install": "bash scripts/install-hooks.sh",
    "prepack": "scripts/bun run build",
    "preview:fixture": "scripts/bun run build && scripts/bun run scripts/preview-fixture.ts"
  },
  "engines": {
    "node": ">=18"
  }
}
